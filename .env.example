NEXTAUTH_URL="https://asana.example.com"
NEXTAUTH_SECRET="replace-with-at-least-32-random-bytes"

# PostgreSQL connection string for the database
DATABASE_URL="postgresql://postgres:change-me@db:5432/asana_clone?schema=public"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="asana_clone"

# Required before storing reusable Asana connections. Generate 32 random bytes.
# One-off inventory requests never persist the supplied PAT.
ASANA_TOKEN_ENCRYPTION_KEY=""

# Optional, development-only. Required only when running `npm run db:seed`.
SEED_DEMO_PASSWORD=""
